{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/sequence build",
  "outputDirectory": "artifacts/sequence/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://123.45.67.89.sslip.io/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
